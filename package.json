{
  "name": "landlord",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "lint": "eslint . && pnpm check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:architecture",
    "test:architecture": "node scripts/check-architecture.test.mjs",
    "build": "pnpm -r --if-present build",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}

{
  "name": "landlord",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "art:staging:validate": "node scripts/validate-art-staging.mjs",
    "art:jobs:validate": "node scripts/validate-asset-jobs.mjs",
    "art:spike:validate": "node scripts/validate-visual-direction-spike.mjs",
    "art:generate": "node scripts/generate-runtime-assets.mjs",
    "art:assets:check": "node scripts/generate-runtime-assets.mjs --check",
    "art:visual": "node scripts/art-visual-capture.mjs",
    "art:slice:capture": "node scripts/visual-slice-capture.mjs",
    "art:profile": "node scripts/art-dense-profile.mjs",
    "art:blender": "node scripts/build-blender-assets.mjs",
    "art:blender:check": "node scripts/build-blender-assets.mjs --check",
    "art:style:check": "python3 tools/art-pipeline/blender/check_style_layer.py",
    "art:render:check": "python3 tools/art-pipeline/blender/check_rendered_night.py",
    "art:external:golden": "python3 scripts/external_visual_golden.py --update",
    "art:external:check": "python3 scripts/external_visual_golden.py --compare",
    "art:binaries:check": "node scripts/check-binary-budget.mjs",
    "art:licenses:check": "node scripts/check-third-party-license.mjs",
    "lint": "eslint . && pnpm check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:architecture",
    "test:architecture": "node scripts/check-architecture.test.mjs",
    "build": "pnpm -r --if-present build",
    "benchmark": "BENCHMARK_FULL=1 vitest run --config vitest.config.ts packages/simulation/src/benchmark.test.ts --reporter=verbose",
    "benchmark:browser": "pnpm build && node scripts/browser-benchmark.mjs",
    "smoke:phase2": "node scripts/phase2-browser-smoke.mjs",
    "smoke:alpha": "node scripts/alpha-browser-smoke.mjs",
    "smoke:vd-core-loop": "node scripts/vd-core-loop-smoke.mjs",
    "smoke:vd-ux": "node scripts/vd-ux-smoke.mjs",
    "smoke:art-lab": "node scripts/art-lab-browser-smoke.mjs",
    "district:inspect": "DISTRICT_INSPECT=1 vitest run --config vitest.config.ts packages/simulation/src/district-inspect.test.ts --reporter=verbose",
    "road:benchmark": "ROAD_BENCHMARK=1 vitest run --config vitest.config.ts packages/simulation/src/road-topology-benchmark.test.ts --reporter=verbose",
    "fabric:gate": "FABRIC_GATE=1 vitest run --config vitest.config.ts packages/simulation/src/urban-fabric-gate.test.ts --reporter=verbose",
    "system:cost": "SYSTEM_COST=1 vitest run --config vitest.config.ts packages/simulation/src/system-cost.test.ts --reporter=verbose",
    "system:cost:monthly": "SYSTEM_COST_MONTHLY=1 vitest run --config vitest.config.ts packages/simulation/src/system-cost-monthly.test.ts --reporter=verbose",
    "soak": "SOAK_FULL=1 vitest run --config vitest.config.ts packages/simulation/src/soak.test.ts --reporter=verbose",
    "audit:metrics": "AUDIT_METRICS=1 vitest run --config vitest.config.ts packages/simulation/src/audit-metrics.test.ts --reporter=verbose",
    "balance:campaign": "BALANCE_CAMPAIGN=1 vitest run --config vitest.config.ts packages/simulation/src/balance.test.ts --reporter=verbose",
    "balance:playable": "PLAYABLE_BALANCE_CAMPAIGN=1 vitest run --config vitest.config.ts packages/simulation/src/balance-playable.test.ts --reporter=verbose",
    "services:balance": "SERVICES_BALANCE=1 vitest run --config vitest.config.ts packages/simulation/src/services-balance.test.ts --reporter=verbose",
    "state:inspect": "STATE_INSPECT=1 vitest run --config vitest.config.ts packages/simulation/src/state-inspect.test.ts --reporter=verbose",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.6",
    "tar": "^7.5.22",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "unzipper": "^0.12.5",
    "vitest": "4.1.10"
  }
}

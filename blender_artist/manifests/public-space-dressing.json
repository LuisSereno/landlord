{
  "schemaVersion": 1,
  "composerVersion": "vg-dressing-1",
  "purpose": "V.g public-space dressing: vocabulario determinista de mobiliario cívico para espacios públicos REALES (plazas y parques). El planificador Blender lee las celdas del fixture (volcadas desde generateDistrict) y coloca módulos por rol y estrategia. Ninguna cifra geométrica vive aquí: el tamaño de celda sale del fixture, el anclaje y los bounds de cada módulo salen del catálogo medido (§6/§7). §22 del compositor prohíbe props de apoyo en el suelo DENTRO del solar; este manifest es la casa autorizada de esos mismos props, pero en el espacio público.",
  "authority": {
    "cells": "blender_artist/manifests/public-space-dressing-fixture.json (celdas reales de generateDistrict)",
    "geometry": "blender_artist/manifests/building-modules.json (módulos medidos en Blender)",
    "provenance": "cada module es un id del catálogo; un id inexistente o con role distinto al declarado falla al cargar, no a mitad de render"
  },
  "prng": {
    "algorithm": "SplitMix64 (prng.py), entero puro de 64 bits — mismo motor que el Building Composer",
    "stateDerivation": "seed ^ FNV-1a(publicSpaceId|kind), con seed = fixture.seed",
    "why": "§13/§14: dos corridas del mismo seed y el mismo fixture dan el mismo dressing; random.del sistema no vale"
  },
  "cellMetersDefault": 4,
  "strategies": {
    "center": "una sola celda en el centroide del conjunto de celdas",
    "perimeter": "celdas de borde (con al menos un vecino fuera del conjunto), muestreadas con stride everyCells",
    "corners": "las 4 esquinas del bounding box de las celdas",
    "inner_ring": "celdas a insetCells del borde, repartidas simétricamente",
    "scatter": "celdas interiores elegidas por densidad con separación mínima minSpacingCells, sorteadas con el PRNG"
  },
  "kinds": {
